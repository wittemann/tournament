# Supabase project URL: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key: Supabase dashboard → Project Settings → API → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry DSN: Sentry → project tournament → Settings → Client Keys (DSN). Empty disables Sentry.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, build-time only (source map upload), never commit: Sentry auth token
# SENTRY_AUTH_TOKEN=
